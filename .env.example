# Copy to .env.local for local development. Set the same names in Vercel
# (see docs/CLOUDFLARE_SETUP.md for which environments). Never commit real values.

# ── Sign-in (unchanged from Phase 1) ─────────────────────────────────────────

# At least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# bcrypt hash of the site password. Generate with:
# npm run hash-password -- "your-password"
# In this file, escape every $ as \$. Example: \$2b\$12\$...
AUTH_PASSWORD_HASH=

# Optional. Name and email of the person who signs in with that password. The
# dashboard shows the name stored in the D1 `users` row; the dev seed uses these
# two values for that row when no SEED_ADMIN_* value is given.
AUTH_USER_NAME=
AUTH_EMAIL=

# ── Database: Cloudflare D1 through the gateway Worker (cloudflare/d1-gateway) ─

# Base URL of the gateway Worker, without a trailing slash.
#   Local:      http://127.0.0.1:8787            (npm run gateway:dev)
#   Deployed:   https://daycare-d1-gateway.<your-subdomain>.workers.dev
D1_GATEWAY_URL=

# Shared HMAC secret, at least 32 characters. Must equal the Worker's GATEWAY_SECRET
# (cloudflare/d1-gateway/.dev.vars locally; `wrangler secret put GATEWAY_SECRET` when deployed).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
D1_GATEWAY_SECRET=

# ── Development seed only (read by `npm run db:seed:local`; never by the app) ──
# Optional overrides; flags (--admin-email, --admin-auth-id, --admin-name) win.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_AUTH_ID=password:usr_bootstrap
# SEED_ADMIN_NAME=
