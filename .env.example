# Environment variable NAMES only — never commit real values.
#
# Where each value lives:
#   Cloudflare Workers (production)  → Worker → Settings → Variables and Secrets
#                                       (see docs/MANUAL_SETUP.md, step 6)
#   Local Workers runtime            → .dev.vars        (copy .dev.vars.example)
#   Local `next dev` / Vercel        → .env.local / Vercel project settings
#
# No NEXT_PUBLIC_* variables are used: nothing here is ever sent to the browser.

# ── Sign-in (SECRETS) ─────────────────────────────────────────────────────────

# At least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Preferred: multiple env logins (JSON array). Not stored in the database.
# Generate each hash with: npm run hash-password -- "your-password"
# In .env.local only, escape every $ as \$. On Vercel paste hashes as-is (no \$).
# AUTH_USERS=[{"username":"admin","passwordHash":"$2b$12$...","name":"Admin"},{"username":"demo","passwordHash":"$2b$12$...","name":"Demo"}]
AUTH_USERS=

# Legacy single-user login (used only when AUTH_USERS is unset).
AUTH_USERNAME=
# bcrypt hash. In .env.local escape $ as \$. Example: \$2b\$12\$...
AUTH_PASSWORD_HASH=
AUTH_USER_NAME=
AUTH_EMAIL=

# ── Platform domain (NON-SECRET; set in wrangler.jsonc "vars" for Cloudflare) ──
# Leave both empty locally: localhost and mydaycare.localhost work without them.
# PLATFORM_ROOT_DOMAIN=visionforgestudio.app
# AUTH_COOKIE_DOMAIN=visionforgestudio.app

# ── Legacy: D1 gateway Worker (only for `next dev` / Vercel, not for Cloudflare) ─
# On Cloudflare Workers the app uses the native D1 binding "DB" instead.
#   Local:      http://127.0.0.1:8787            (npm run gateway:dev)
D1_GATEWAY_URL=
# Must equal the gateway Worker's GATEWAY_SECRET (cloudflare/d1-gateway/.dev.vars).
D1_GATEWAY_SECRET=

# ── Development seed only (read by `npm run db:seed:local`; never by the app) ──
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_AUTH_ID=password:usr_bootstrap
# SEED_ADMIN_NAME=
