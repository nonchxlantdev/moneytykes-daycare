{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The daycare application itself, running on Cloudflare Workers via vinext.
  // One Worker serves the platform domain and every daycare subdomain.
  // Secrets are NEVER stored here — see docs/CLOUDFLARE_DEPLOYMENT.md.
  "name": "vision-forge-daycare",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-06",
  // nodejs_compat: Node APIs used by the app (bcryptjs, Buffer) and process.env
  // populated from vars + secrets.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Keep the *.workers.dev URL for pre-cutover testing and preview URLs for branches.
  "workers_dev": true,
  "preview_urls": true,

  // Non-secret runtime configuration (process.env.*).
  "vars": {
    // Platform domain; "<slug>.<PLATFORM_ROOT_DOMAIN>" is a daycare.
    "PLATFORM_ROOT_DOMAIN": "visionforgestudio.app",
    // Session cookie is shared by the platform domain and all daycare subdomains.
    "AUTH_COOKIE_DOMAIN": "visionforgestudio.app"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daycare-db",
      // Replace with the ID printed by `npx wrangler d1 create daycare-db`
      // (docs/MANUAL_SETUP.md step 3). The ID is not a secret.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Generated by drizzle-kit; applied ONLY by explicit `npm run db:migrate:*` commands.
      "migrations_dir": "drizzle/migrations"
    }
  ]

  // ── Production domains (docs/MANUAL_SETUP.md, "Cutover") ──────────────────
  // Leave commented until the workers.dev URL has passed testing. To go live,
  // add a comma after the "d1_databases" array above, uncomment this block,
  // commit and push. Also create the wildcard DNS record described in the docs.
  //
  // "routes": [
  //   { "pattern": "visionforgestudio.app", "custom_domain": true },
  //   { "pattern": "*.visionforgestudio.app/*", "zone_name": "visionforgestudio.app" }
  // ]
}
