{
  "name": "daycare-d1-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticated D1 gateway Worker — only used by the temporary Vercel deployment and `next dev` (Vercel → Worker → D1). Retire with Vercel.",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to ../../.wrangler/state",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrations:list:local": "wrangler d1 migrations list DB --local --persist-to ../../.wrangler/state",
    "migrations:list:remote": "wrangler d1 migrations list DB --remote",
    "migrations:apply:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "migrations:apply:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
