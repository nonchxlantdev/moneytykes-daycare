{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Authenticated SQL gateway between the Next.js app (Vercel) and Cloudflare D1.
  "name": "daycare-d1-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daycare-db",
      // Replace with the ID printed by `npx wrangler d1 create daycare-db`
      // (see docs/CLOUDFLARE_SETUP.md). The ID is not a secret.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Migrations are generated by drizzle-kit at the repo root and applied
      // ONLY by explicit `wrangler d1 migrations apply` commands.
      "migrations_dir": "../../drizzle/migrations"
    }
  ]
  // Secret (never in this file): GATEWAY_SECRET — set with
  //   npx wrangler secret put GATEWAY_SECRET          (production)
  //   .dev.vars file with GATEWAY_SECRET=...           (local `wrangler dev`)
}
