{
  "name": "daycare_project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "tsx scripts/seed/seed.ts --target local",
    "db:seed:remote": "tsx scripts/seed/seed.ts --target remote",
    "gateway:dev": "npm --prefix cloudflare/d1-gateway run dev",
    "gateway:deploy": "npm --prefix cloudflare/d1-gateway run deploy",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "deploy:vinext": "vinext-cloudflare deploy",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "db:migrations:list:remote": "wrangler d1 migrations list DB --remote",
    "preview:vinext": "vite build && wrangler dev --port 8788",
    "tenant:create:local": "tsx scripts/tenants/create-tenant.ts --target local",
    "tenant:create:remote": "tsx scripts/tenants/create-tenant.ts --target remote"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vinext": "^1.0.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "type": "module"
}
